{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "esnext",
    "sourceMap": false,
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],

    "paths": {
      "/@/*": ["./src/*", "../api/src/*"],
      "@podman-desktop/core-api/ipc-invoke": ["../api/src/ipc-invoke/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "exposedInMainWorld.d.ts", "exposed-api.d.ts", "../../types/**/*.d.ts"]
}
