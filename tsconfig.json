{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "types": ["node", "vitest/globals"],
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["**/vitest.config.ts", "**/vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/builtin/**", "**/dist/**"]
}
